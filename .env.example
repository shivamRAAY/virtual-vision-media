# =========================================================================
# VIRTUAL VISION MEDIA — VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# Add these in Vercel Dashboard -> Project -> Settings -> Environment Variables
# =========================================================================

# 1. Razorpay Live Payment Gateway Credentials
# IMPORTANT: For real customer payments (₹49 via UPI / GPay / PhonePe / Card),
# you MUST use LIVE keys (starting with rzp_live_...).
# Test keys (rzp_test_...) will DECLINE real payments from banks/UPI.
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET_HERE
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_HERE

# 2. Resend Email Delivery API (Free 3,000 emails/mo at https://resend.com)
# Create a free API key at https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_ACTUAL_RESEND_KEY_HERE
RESEND_FROM="Virtual Vision Media <onboarding@resend.dev>"

# 3. Private Executive Dashboard Credentials
ADMIN_USERNAME=vvm_admin
ADMIN_PASSWORD=vvm_master_vault_2026!

# 4. Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://virtual-vision-media.vercel.app
